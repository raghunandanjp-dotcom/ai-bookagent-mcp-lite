{
  "name": "ai-bookagent-mcp-lite",
  "version": "0.1.0",
  "description": "A host-assisted MCP for creating children's creature poetry books without paid model API keys.",
  "type": "module",
  "bin": {
    "ai-bookagent-mcp": "./dist/server.js",
    "ai-bookagent": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "assets/fonts/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:pptx": "vitest run tests/pptx-validation.test.ts tests/pptx-export.test.ts",
    "qa:pptx:inspect": "vitest run tests/pptx-export.test.ts",
    "qa:pptx:render": "npm run build && node scripts/render-pptx-qa.mjs",
    "qa:docx:render": "npm run build && node scripts/render-docx-qa.mjs",
    "qa:pdf:inspect": "vitest run tests/exporters.test.ts",
    "qa:pdf:render": "npm run build && node scripts/render-pdf-qa.mjs",
    "test:smoke": "npm run build && node scripts/smoke-core.mjs",
    "test:package": "npm run prepack && node scripts/test-packed-package.mjs",
    "test:watch": "vitest",
    "check": "npm run build && npm run check:entrypoints && npm test && npm run check:paths",
    "check:paths": "node scripts/check-portability.mjs",
    "check:entrypoints": "node scripts/check-entrypoints.mjs",
    "check:release-files": "node scripts/check-release-files.mjs",
    "check:package": "npm run prepack && node scripts/check-package-contents.mjs",
    "prepack": "npm run build && npm run check:release-files",
    "prepublishOnly": "npm run check && npm run test:package"
  },
  "keywords": [
    "mcp",
    "children",
    "books",
    "docx",
    "canva",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "pdfkit": "^0.17.1",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.3",
    "pdfjs-dist": "^5.4.149",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
